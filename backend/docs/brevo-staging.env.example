# Copy to backend/.env.staging and replace all placeholders.
# Never commit .env.staging or put secrets in frontend VITE_* variables.
NODE_ENV=development
EMAIL_PROVIDER=brevo
BREVO_API_KEY=REPLACE_WITH_PRIVATE_BREVO_REST_API_KEY
EMAIL_FROM=verified-sender@example.com
EMAIL_FROM_NAME=DJEMC Alumni Staging
BREVO_TEST_GMAIL=authorized-test-inbox@gmail.com
REGISTRATION_OTP_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_BYTES

# Local isolated MySQL database only. Do not use production/Aiven values.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=djemc_alumni_staging
DB_USER=djemc_staging_user
DB_PASS=REPLACE_WITH_LOCAL_STAGING_DATABASE_PASSWORD
